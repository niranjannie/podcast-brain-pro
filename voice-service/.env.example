# ===========================================
# Podcast Brain Pro - Environment Config
# ===========================================
# Copy this file to .env and fill in your keys.
# At least one LLM provider is required for script generation.

# --- Primary Script Provider (Recommended) ---
DIALOGRAM_API_KEY=

# --- Fallback Script Providers ---
GROQ_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
OPENROUTER_API_KEY=
# Local Ollama works without any key:
#   OLLAMA_MODEL=qwen3:8b
#   OLLAMA_API_BASE=http://localhost:11434

# --- Optional model overrides ---
# Providers retire model ids, so the id for each provider can be overridden here
# without touching code. The defaults in the code are the ids that are live today.
# DIALOGRAM_MODEL=qwen-3.6-plus
# GROQ_MODEL=openai/gpt-oss-120b
# DEEPSEEK_MODEL=deepseek-v4-flash
# GEMINI_MODEL=gemini-2.5-flash
# MISTRAL_MODEL=mistral-small-latest
# TOGETHER_MODEL=together_ai/deepseek-ai/DeepSeek-V4.1-Flash-1017
# OPENROUTER_MODEL=auto   # auto picks a free model from the live catalogue

# --- Optional: Indian Language TTS ---
SARVAM_API_KEY=

# --- Optional: Live Web Research ---
TAVILY_API_KEY=

# --- Optional: Override default paths ---
# VOICES_DIR=../vibevoice-src/demo/voices/streaming_model
# LONGFORM_VOICES_DIR=../vibevoice-src/demo/voices
# OUTPUT_DIR=./outputs

# --- Optional: Move HuggingFace model cache (models are large!) ---
# HF_HOME=/path/to/larger/disk/.cache/huggingface

# --- Optional: Preload ASR on startup ---
# ASR_PRELOAD_AT_STARTUP=false

# --- Optional: Tune Longform TTS for your hardware ---
# Lower DDPM steps = faster generation, slightly lower quality (default: 5)
# LONGFORM_DDPM_STEPS=5
# Smaller chunks = less RAM usage, more stitching gaps (default: 350 on MPS, 300 on CPU)
# MAX_LONGFORM_WORDS_MPS=350
# MAX_LONGFORM_WORDS_CPU=300

# --- Optional: Audio delivery ---
# Normalise every export to podcast loudness (-16 LUFS, -1.5 dBTP). Needs ffmpeg.
# NORMALIZE_LOUDNESS=true
# PUBLIC_BASE_URL=https://your-public-host.example   # used for the RSS enclosure URLs
# PODCAST_TITLE=Podcast Brain Pro
# PODCAST_DESCRIPTION=AI generated podcasts, rendered locally
# PODCAST_AUTHOR=Podcast Brain Pro
# PODCAST_LANGUAGE=en-us
# PODCAST_CATEGORY=Technology
